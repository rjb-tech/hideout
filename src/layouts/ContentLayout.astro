---
import { Pane } from "@components/pane";
import DefaultLayout from "./DefaultLayout.astro";
import { Window } from "@components/window";
import { GoHome } from "@components/goHome";

const { frontmatter } = Astro.props;
---

<DefaultLayout title="RJB Tech Blog">
  <Window dynamicHeight>
    <Pane fullWidth>
      <h1>
        {frontmatter.title}
      </h1>
    </Pane>
    <Pane fullWidth>
      <div class="contentContainer">
        <GoHome />
        <div class="content">
          <slot />
        </div>
      </div>
    </Pane>
  </Window>
</DefaultLayout>

<style>
  h1 {
    margin: 2rem 0;

    @media (width < 768px) {
      margin: 1rem 0;
    }
  }

  .contentContainer {
    height: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    box-sizing: border-box;
    gap: 1rem;

    @media (width < 768px) {
      padding: 1rem;
    }
  }

  .content {
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    text-align: left;
    line-height: 1.5rem;
  }

  header {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 0;

    @media (width <= 768px) {
      padding: 0.5rem 0;
    }
  }
</style>
