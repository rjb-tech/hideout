---
import type { MarkdownInstance } from "astro";
import type { BlogPost } from "@hideoutTypes/blog";
import Layout from "@layouts/Layout.astro";
import { SynthPane } from "@components/panes/synth";
import { Blog } from "@components/panes/blog";

import styles from "./home.module.scss";

const posts = Object.values(
  import.meta.glob<MarkdownInstance<BlogPost>>("@content/blog/published/*.md", {
    eager: true,
  }),
);
---

<Layout title="RJB Tech">
  <main>
    <div class={styles.container}>
      <div class={styles.topContainer}>
        <div class={styles.bioContainer}>
          <img src="/logo.png" />
          <span class={styles.name}>Ryne Burden</span>
          <span class={styles.job}>Software Engineer</span>
          <div>
            <a href="https://github.com/rjb-tech">Github</a>
          </div>
          <div>
            <a href="https://www.linkedin.com/in/ryne-burden-4210a0a3/">
              LinkedIn
            </a>
          </div>
        </div>
        <div class={styles.blogContainer}>
          <Blog posts={posts} client:load />
        </div>
      </div>
      <div class={styles.synthContainer}>
        <SynthPane client:only />
      </div>
      <!-- <div class={styles.otherContainer}>
        
        <div class={styles.synthContainer}>
          <SynthPane client:only />
        </div>
      </div> -->
    </div>
  </main>
</Layout>

<style>
  main {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }
</style>
