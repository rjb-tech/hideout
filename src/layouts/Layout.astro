---
import Analytics from "@vercel/analytics/astro";
import "../styles/fonts.scss";
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Ryne's Hideout" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"
    ></script>
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.net.min.js"
    ></script>
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        // @ts-ignore
        VANTA.NET({
          el: "#vanta-bg",
          mouseControls: true,
          touchControls: false,
          gyroControls: true,
          minHeight: window.innerHeight,
          minWidth: window.innerWidth,
          scale: 1.0,
          scaleMobile: 1.0,
          color: 0x46867e,
          backgroundColor: 0x0,
          points: 12.0,
        });
      });
    </script>
    <Analytics />
    <base target="_blank" /></head
  >

  <body>
    <div id="vanta-bg">
      <main>
        <slot />
      </main>
    </div>
    <style is:global>
      html {
        font-family: "exo_2light", sans-serif;
        color: #f4f4f9; /* same as vars.$white */
        height: 100vh;
        width: 100vw;
      }
      body {
        width: 100vw;
        height: 100vh;
        margin: 0;
        overflow: hidden;
      }
      main {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        overflow-y: scroll;

        @media (width <= 768px) {
          align-items: flex-start;
        }
      }
      code {
        font-family:
          Menlo,
          Monaco,
          Lucida Console,
          Liberation Mono,
          DejaVu Sans Mono,
          Bitstream Vera Sans Mono,
          Courier New,
          monospace;
      }
      a {
        color: white;
      }
      #vanta-bg {
        height: 100vh;
        width: 100vw;
      }
    </style>
  </body>
</html>
