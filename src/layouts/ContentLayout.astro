---
import { Pane } from "@components/pane";
import DefaultLayout from "./DefaultLayout.astro";
import { Window } from "@components/window";
import { GoHome } from "@components/goHome";

const { frontmatter } = Astro.props;
---

<DefaultLayout title="RJB Tech Blog">
  <Window dynamicHeight>
    <Pane fullWidth>
      <header>
        <h1>
          {frontmatter.title}
        </h1>
        <GoHome />
      </header>
    </Pane>
    <Pane fullWidth> <div class="content"><slot /></div> </Pane>
  </Window>
</DefaultLayout>

<style>
  h1 {
    margin: 0;
  }

  .content {
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    padding: 2rem;
    text-align: left;
  }

  header {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 0;

    @media (width <= 768px) {
      padding: 0.5rem 0;
    }
  }
</style>
