---
import { Pane } from "@components/pane";
import DefaultLayout from "./DefaultLayout.astro";
import { Window } from "@components/window";
import { GoHome } from "@components/goHome";
import { format, formatISO } from "date-fns";
import { toZonedTime } from "date-fns-tz";

const { frontmatter } = Astro.props;

const date = toZonedTime(new Date(frontmatter.date), "UTC");
const published = format(date, "MMMM dd, yyyy");

const showTags = frontmatter.tags.length > 0;
const titleMap: Record<string, string> = {
  Portfolio: "Ryne Portfolio",
  Resume: "Ryne Resume",
};
---

<DefaultLayout title={titleMap[frontmatter.title] ?? "RJB Tech Blog"}>
  <Window dynamicHeight>
    <Pane fullWidth>
      <h1>
        {frontmatter.title}
      </h1>
    </Pane>
    <Pane fullWidth>
      <div class="contentContainer">
        <div class="contentHeader">
          <GoHome />
          <div class="contentInformation">
            {
              showTags && (
                <span class="tagContainer">
                  Tags:{" "}
                  {frontmatter.tags.map((tag: any) => (
                    <span class="tag">{tag}</span>
                  ))}
                </span>
              )
            }
            <datetime published={formatISO(published)}>
              {`Published ${published}`}
            </datetime>
          </div>
        </div>
        <div class="content">
          <slot />
        </div>
      </div>
    </Pane>
  </Window>
</DefaultLayout>

<style>
  h1 {
    margin: 2rem 0;

    @media (width < 768px) {
      margin: 1rem 0;
    }
  }

  .contentContainer {
    height: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    box-sizing: border-box;
    gap: 1rem;

    @media (width < 768px) {
      padding: 1rem;
    }
  }

  .contentHeader {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;

    @media (width < 768px) {
      flex-direction: column;
      gap: 1rem;
    }
  }

  .contentInformation {
    display: flex;
    align-items: flex-end;
    flex-direction: column;
    gap: 1rem;

    @media (width < 768px) {
      flex-direction: column-reverse;
      align-items: center;
    }

    .tagContainer {
      display: flex;
      gap: 0.5rem;
    }
    .tag {
      font-size: x-small;
      width: fit-content;
      height: fit-content;
      text-align: center;
      border: 1px solid #f4f4f9;
      padding: 3px;
      border-radius: 4px;
      opacity: 1;
      display: flex;
    }
  }

  .content {
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    text-align: left;
    line-height: 1.5rem;
  }
</style>
