---
import type { MarkdownInstance } from "astro";
import type { HideoutMarkdown } from "@hideoutTypes/content";
import DefaultLayout from "@layouts/DefaultLayout.astro";
import { SynthPane } from "@components/synth";
import { Blog } from "@components/blog";
import { Window } from "@components/window";
import { Pane } from "@components/pane";

import styles from "./_home.module.scss";

const posts = Object.values(
  import.meta.glob<MarkdownInstance<HideoutMarkdown>>("@pages/blog/*.md", {
    eager: true,
  }),
);
---

<!-- 
To Do 
  Add tag generation to remark plugins
  Wire up read this button
  Add second oscillator
    Only accessible on large screens
  Wire up envelope to filter
    lil envelope button
  Fix filter so it doesn't stop the sound on change
  Add go home button to portfolio page
  Move post tags below nav arrow
-->
<DefaultLayout title="RJB Tech">
  <Window>
    <div class={styles.topContainer}>
      <Pane>
        <img src="/logo.png" />
        <span class={styles.name}>Ryne Burden</span>
        <span class={styles.job}>Software Engineer</span>
        <div>
          <a href="/portfolio" target="_self"> Portfolio </a>
        </div>
        <div>
          <a href="https://github.com/rjb-tech">Github</a>
        </div>
        <div>
          <a href="https://www.linkedin.com/in/ryne-burden-4210a0a3/">
            LinkedIn
          </a>
        </div>
      </Pane>
      <Pane>
        <Blog posts={posts} client:load />
      </Pane>
    </div>
    <div class={styles.bottomContainer}>
      <Pane fullWidth><SynthPane client:only /></Pane>
    </div>
  </Window>
</DefaultLayout>
