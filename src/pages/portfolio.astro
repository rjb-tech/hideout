---
import { Pane } from "@components/pane";
import { Window } from "@components/window";
import Layout from "@layouts/Layout.astro";
import { Content as PortfolioContent } from "@content/portfolio/portfolio.md";
import { HomeIcon } from "@heroicons/react/16/solid";
---

<Layout title="RJB Tech Portfolio">
  <Window dynamicHeight>
    <Pane fullWidth> <h1>Portfolio</h1> </Pane>
    <Pane fullWidth>
      <div class="styleContainer">
        <PortfolioContent />
      </div>
    </Pane>
  </Window>

  <style>
    * {
      text-align: left;
    }

    .styleContainer {
      padding: 1rem;
    }

    .topContainer {
      display: flex;
      width: 100%;
      height: 4rem;
      justify-content: flex-start;
      align-items: flex-start;
    }

    .goHome {
      height: 100%;
      background-color: red;
    }
  </style>
</Layout>
